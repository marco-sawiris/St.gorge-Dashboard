# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: External Backend API base URL (e.g. https://st-george-service-api.onrender.com)
# Leave blank for local full-stack / relative routing.
VITE_API_BASE_URL=""

# Backend Authentication Secrets (Set strong random strings in production)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# PostgreSQL Database Connection (Optional - falls back to resilient store if omitted)
DATABASE_URL=""

# Google Sheets Service Account Integration (Optional - falls back to authoritative server store if omitted)
GOOGLE_SHEET_ID="15Nda4pGb3WdAfOuRTwRS9Fx822_EORgumOmhZcjTVt0"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""


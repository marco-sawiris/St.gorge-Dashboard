 @import "tailwindcss";
+@custom-variant dark (&:where(.dark, .dark *));
+
+/* ==========================================================================
+   Marco Sawiris Design System (v2.0) — Unified Liquid Glass Specification
+   Identity: Blue & Cyan (Midnight Black, Deep Navy, Electric Blue, Cyan)
+   RTL First | Ultra-Dark Foundations | Zero-Green Discipline
+   Central Design Tokens for Dark & Light Themes
+   ========================================================================== */
+
+:root, [data-theme="dark"] {
+  /* Central Design Tokens - Dark Theme */
+  --app-bg: #030711;
+  --surface-primary: #071B3B;
+  --surface-secondary: #0B2452;
+  --surface-glass: rgba(7, 27, 59, 0.70);
+  --surface-glass-strong: rgba(11, 36, 82, 0.85);
+  --text-primary: #FFFFFF;
+  --text-secondary: rgba(255, 255, 255, 0.78);
+  --text-muted: rgba(255, 255, 255, 0.52);
+  --border-color: rgba(38, 122, 255, 0.24);
+  --border-focus: #20C7E8;
+  --accent-primary: #267AFF;
+  --accent-secondary: #20C7E8;
+  --success: #20C7E8; /* Cyan, strictly zero green */
+  --warning: #F59E0B;
+  --danger: #EF4444;
+  --shadow: 0 4px 20px rgba(3, 7, 17, 0.85);
+  --glass-blur: 24px;
+
+  /* 7 Approved Blue & Cyan Colors */
+  --midnight: #030711;
+  --navy: #071B3B;
+  --navy-mid: #0B2452;
+  --royal: #123FCE;
+  --primary: #267AFF;
+  --primary-hover: #3D8DFF;
+  --accent: #20C7E8;
+  --indigo: #3020A0;
+  --violet: #6548F5;
+
+  /* Backgrounds & Liquid Glass Surfaces (Ultra-Dark Foundation) */
+  --bg: var(--app-bg);
+  --bg-el: var(--surface-primary);
+  --bg-high: var(--surface-secondary);
+  --glass-bg: var(--surface-glass);
+  --glass-bg-2: var(--surface-glass-strong);
+  --glass-bg-3: rgba(38, 122, 255, 0.20);
+  --glass-border: var(--border-color);
+  --glass-border-2: rgba(32, 199, 232, 0.45);
+  --glass-inset-top: inset 0 1px 0 rgba(32, 199, 232, 0.35);
+  --glass-inset-bot: inset 0 -1px 0 rgba(3, 7, 17, 0.50);
+
+  /* Typography */
+  --text: var(--text-primary);
+  --on-primary: #030711;
+
+  /* Semantic States (Notice: Cyan is Success, ZERO GREEN) */
+  --info: #267AFF;
+
+  /* Gradients */
+  --grad-primary: linear-gradient(135deg, #267AFF 0%, #123FCE 100%);
+  --grad-accent: linear-gradient(135deg, #20C7E8 0%, #267AFF 60%, #3020A0 100%);
+  --grad-indigo: linear-gradient(135deg, #3020A0 0%, #6548F5 100%);
+  --grad-deep: linear-gradient(180deg, #071B3B 0%, #030711 100%);
+  --grad-lens: linear-gradient(180deg, rgba(32, 199, 232, 0.35) 0%, rgba(38, 122, 255, 0.18) 100%);
+
+  /* Shadows, Insets & Glows */
+  --shadow-1: var(--shadow);
+  --shadow-2: 0 14px 44px rgba(3, 7, 17, 0.95);
+  --shadow-primary: 0 0 0 1px rgba(38, 122, 255, 0.40), 0 10px 30px -6px rgba(38, 122, 255, 0.55);
+  --shadow-accent: 0 0 0 1px rgba(32, 199, 232, 0.35), 0 8px 24px -8px rgba(32, 199, 232, 0.45);
+  --focus-ring: 0 0 0 3px rgba(32, 199, 232, 0.35);
+
+  /* Spacing Scale & Easing Curves */
+  --s1: .25rem; --s2: .5rem; --s3: .75rem; --s4: 1rem; --s5: 1.25rem;
+  --s6: 1.5rem; --s8: 2rem; --s10: 2.5rem; --s12: 3rem;
+  --r-sm: .5rem; --r-md: .875rem; --r-lg: 1.25rem; --r-xl: 1.75rem; --r-pill: 999px;
+  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
+  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
+  --ease-out: cubic-bezier(0.25, 1, 0.5, 1);
+
+  /* Backward Compatibility Aliases for App Components */
+  --bg-main: var(--app-bg);
+  --card-bg: var(--surface-glass);
+  --text-main: var(--text-primary);
+  --border: var(--border-color);
+  --sidebar-bg: var(--surface-glass-strong);
+  --input-bg: rgba(7, 27, 59, 0.65);
+  --green-status: var(--success);
+  --red-status: #e11d48;

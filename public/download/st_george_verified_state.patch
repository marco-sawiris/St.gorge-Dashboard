+export async function executeSyncData(
+  targetSheet: SheetName,
+  user: AuthUser | null,
+  isPreviewMode: boolean,
+  syncInProgressRef: { current: boolean },
+  onNotify?: (title: string, desc?: string, type?: 'info' | 'warn' | 'success' | 'danger') => void,
